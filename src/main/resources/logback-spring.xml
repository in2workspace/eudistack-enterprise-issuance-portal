<?xml version="1.0" encoding="UTF-8"?>
<!--
  One JSON line per entry, with the fields of the log contract (conv-observability §2).
  Personal data never reaches a log: identity, source data and email stay in the encrypted session,
  and SessionId never prints its value.
-->
<configuration>

    <springProperty name="serviceName" source="spring.application.name"/>
    <springProperty name="serviceVersion" source="issuance-portal.version" defaultValue="unknown"/>
    <springProperty name="env" source="issuance-portal.env" defaultValue="local"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <pattern>
                    <pattern>{"service.name":"${serviceName}","service.version":"${serviceVersion}","env":"${env}"}</pattern>
                </pattern>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <message/>
                <!-- traceId and spanId come from Micrometer Tracing; tenant.id from TenantFilter. -->
                <mdc>
                    <mdcKeyFieldName>traceId=trace_id</mdcKeyFieldName>
                    <mdcKeyFieldName>spanId=span_id</mdcKeyFieldName>
                </mdc>
                <arguments/>
                <throwableClassName>
                    <fieldName>error.type</fieldName>
                </throwableClassName>
                <throwableMessage>
                    <fieldName>error.message</fieldName>
                </throwableMessage>
                <stackTrace>
                    <fieldName>error.stack_trace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
